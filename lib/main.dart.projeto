import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class TempoRealPage extends StatefulWidget {
  const TempoRealPage({super.key});

  @override
  State<TempoRealPage> createState() => _TempoRealPageState();
}

class _TempoRealPageState extends State<TempoRealPage> {
  final supabase = Supabase.instance.client;
  List<Map<String, dynamic>> dados = [];
  bool carregando = true;

  @override
  void initState() {
    super.initState();
    carregarDados();
    escutarTempoReal();
  }

  Future<void> carregarDados() async {
    try {
      final res = await supabase.from('dominion_live').select().order('created_at', ascending: false);
      setState(() {
        dados = List<Map<String, dynamic>>.from(res);
        carregando = false;
      });
    } catch (e) {
      setState(() => carregando = false);
      debugPrint('Erro: $e');
    }
  }

  void escutarTempoReal() {
    supabase
        .channel('dominion_live_channel')
        .onPostgresChanges(
          event: PostgresChangeEvent.all,
          schema: 'public',
          table: 'dominion_live',
          callback: (payload) {
            carregarDados(); // atualiza quando tiver dado novo
          },
        )
        .subscribe();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.black,
      appBar: AppBar(
        title: const Text('DOMINION LIVE - Tempo Real'),
        backgroundColor: Colors.red,
        centerTitle: true,
      ),
      body: carregando
          ? const Center(child: CircularProgressIndicator(color: Colors.red))
          : dados.isEmpty
              ? const Center(
                  child: Text(
                    'Nenhum dado ainda.\nAdicione algo no Supabase!',
                    textAlign: TextAlign.center,
                    style: TextStyle(color: Colors.white, fontSize: 18),
                  ),
                )
              : ListView.builder(
                  padding: const EdgeInsets.all(12),
                  itemCount: dados.length,
                  itemBuilder: (context, i) {
                    final item = dados[i];
                    return Card(
                      color: Colors.grey[900],
                      margin: const EdgeInsets.only(bottom: 12),
                      child: ListTile(
                        leading: const Icon(Icons.live_tv, color: Colors.red),
                        title: Text(
                          item['titulo'] ?? 'Sem título',
                          style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
                        ),
                        subtitle: Text(
                          item['descricao'] ?? '',
                          style: const TextStyle(color: Colors.white70),
                        ),
                        trailing: Text(
                          'AO VIVO',
                          style: TextStyle(color: Colors.red[400], fontWeight: FontWeight.bold),
                        ),
                      ),
                    );
                  },
                ),
      floatingActionButton: FloatingActionButton(
        backgroundColor: Colors.red,
        onPressed: carregarDados,
        child: const Icon(Icons.refresh),
      ),
    );
  }
}